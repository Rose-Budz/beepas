{
  "name": "beepas-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "typecheck": "turbo typecheck",
    "spell": "turbo spell",
    "knip": "turbo knip",
    "knip:fix": "turbo knip:fix",
    "check": "turbo run typecheck lint spell knip && pnpm format:check",
    "fix": "turbo fix && pnpm format",
    "prepare": "node -e \"const {execSync}=require('child_process');if(!process.env.CI&&!process.env.VERCEL){try{execSync('git rev-parse --git-dir',{stdio:'ignore'});execSync('pnpm exec lefthook install',{stdio:'inherit'})}catch{}}\"",
    "pre-commit": "lefthook run pre-commit",
    "clean": "turbo clean && node -e \"fs.rmSync('node_modules', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "lefthook": "^1.13.6",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
