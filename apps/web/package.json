{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\"",
    "spell": "cspell \"app/**/*.{ts,tsx}\"",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm spell && pnpm knip",
    "fix": "pnpm lint:fix && pnpm format && pnpm knip:fix",
    "prepare": "node -e \"const {execSync}=require('child_process');try{execSync('git rev-parse --git-dir',{cwd:'../..',stdio:'ignore'});execSync('pnpm exec lefthook install',{stdio:'inherit'})}catch{console.log('Git or lefthook unavailable - skipping lefthook install')}\"",
    "pre-commit": "lefthook run pre-commit",
    "clean": "node -e \"for (const p of ['dist','build','.react-router','node_modules/.vite']) fs.rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/recipes": "^0.5.7",
    "clsx": "^1.2.1",
    "radix-ui": "^1.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^9.8.0",
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^7.18.5",
    "@react-router/node": "^7.18.5",
    "@types/node": "^25.9.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "cspell": "^9.8.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "knip": "^6.44.2",
    "lefthook": "^1.13.6",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
